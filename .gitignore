# OS junk
.DS_Store
Thumbs.db

# Scratch / working folders — never push
media/new_media/
media/old_media/

# Local-only notes / debug
media/README.md
FIX_TERMINAL.md

# Intro videos: only horizontal versions are used by the site
media/introductions/*_vertical.mp4

# Skip raw .mov source clips — only transcoded .mp4 versions are used
media/skills/*.mov
media/casual/*.mov

# Skills: ignore all, then whitelist clips referenced by script.js
media/skills/**
!media/skills/
!media/skills/tennis.mp4
!media/skills/golf.mp4
!media/skills/ski.mp4
!media/skills/raisingsail.mp4

# Off-Duty / casual: ignore all, then whitelist files referenced by script.js
media/casual/**
!media/casual/
!media/casual/river.mp4
